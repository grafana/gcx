{
  "kind": "QueryTypeDefinitionList",
  "apiVersion": "datasource.grafana.app/v0alpha1",
  "items": [
    {
      "metadata": {
        "name": "probe_execution_rate"
      },
      "spec": {
        "description": "Rate of successful check executions per probe, summed across all checks in the tenant.",
        "schema": {
          "$schema": "https://json-schema.org/draft-04/schema",
          "type": "object"
        }
      }
    },
    {
      "metadata": {
        "name": "checks_uptime"
      },
      "spec": {
        "description": "Uptime for a single check over its execution frequency window, as the app displays it.",
        "schema": {
          "$schema": "https://json-schema.org/draft-04/schema",
          "properties": {
            "frequency": {
              "description": "Frequency is the check's frequency in milliseconds. Must be positive.",
              "type": "integer"
            },
            "instance": {
              "description": "Instance is the check's instance label.",
              "type": "string"
            },
            "job": {
              "description": "Job is the check's job label.",
              "type": "string"
            }
          },
          "required": [
            "job",
            "instance",
            "frequency"
          ],
          "type": "object"
        }
      }
    }
  ]
}
