name: Deploy Grafana Dashboards
on:
  push:
    branches: [main]
    paths: ['resources/**']

permissions:
  contents: read

env:
  # Leave empty to install the latest gcx release, or set a version (e.g. '1.8.0') to pin it.
  GCX_VERSION: ''

jobs:
  deploy:
    name: Deploy Grafana resources
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Install gcx
        shell: bash
        run: |
          mkdir -p "${HOME}/.local/bin/"
          # No tag means the latest release; GCX_VERSION (when set) pins one.
          gh release download ${GCX_VERSION:+"v${GCX_VERSION#v}"} \
            --repo grafana/gcx --pattern 'gcx_*_linux_amd64.tar.gz' --output gcx.tar.gz
          tar -xzf gcx.tar.gz gcx
          mv gcx "${HOME}/.local/bin/gcx"
          chmod +x "${HOME}/.local/bin/gcx"
          echo "bin-path=${HOME}/.local/bin" >> "${GITHUB_OUTPUT}"
        env:
          GH_TOKEN: {{ `${{ github.token }}` }}

      - name: Setup go
        uses: actions/setup-go@v6

      - name: Generate manifests
        shell: bash
        run: |
          go run .

      - name: Validate manifests
        shell: bash
        run: |
          gcx resources validate -p ./resources
        env:
          GRAFANA_SERVER: {{ `${{ secrets.GRAFANA_URL }}` }}
          GRAFANA_TOKEN: {{ `${{ secrets.GRAFANA_TOKEN }}` }}

      - name: Deploy
        shell: bash
        run: |
          gcx resources push -p ./resources --on-error abort
        env:
          GRAFANA_SERVER: {{ `${{ secrets.GRAFANA_URL }}` }}
          GRAFANA_TOKEN: {{ `${{ secrets.GRAFANA_TOKEN }}` }}
