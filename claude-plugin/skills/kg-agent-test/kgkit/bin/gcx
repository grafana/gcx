#!/usr/bin/env bash
# Knowledge Graph agent test skill: gcx wrapper.
#
# Every gcx command the agent runs passes through here. It is logged to
# $KGKIT_LOG. In every configuration, commands that would change the stack are
# refused. In the "without-graph" configuration the Knowledge Graph is hidden:
# gcx kg answers as an unknown command, help and discovery output leaves it out
# (via ../hide_kg.py), and other routes to its data are refused.
#
#   KGKIT_REAL_GCX  path to the real gcx binary (required)
#   KGKIT_MODE      with-graph | without-graph
#   KGKIT_LOG       file to append one line per command to
#   KGKIT_CONTEXT   optional gcx context to add to every command

real="${KGKIT_REAL_GCX:?KGKIT_REAL_GCX is not set}"
log="${KGKIT_LOG:-/dev/null}"
mode="${KGKIT_MODE:-with-graph}"

blocked=""

# Read-only in every configuration. The test asks questions; it must never change the
# stack it runs against. Look at the command path (the words before the first flag,
# after any leading global flags) and refuse it if any word is a verb that writes,
# starts something, or reconfigures gcx. Arguments after a flag, such as query
# strings, are never matched.
WRITE_VERBS=" acknowledge add add-conversations annotate apply apply-sourcemap archive cancel clear close
  configure create delete delete-schedule delete-sourcemap deploy dismiss drop-rules edit emit escalate
  exclude import include install login mode new open pause publish push remove remove-conversation reset
  reset-token resolve restore resume run save scaffold serve set setup share signup silence start
  start-maintenance stop-maintenance test test-run unacknowledge unarchive uninstall unresolve unset
  unsilence update update-allowed-load-zones update-allowed-projects update-script update-templates
  upsert use-context snapshot judge generate token "
# whole command groups that can act on the stack or call it without a fixed verb
WRITE_GROUPS=" api assistant "
path=()
skip_next=""
for a in "$@"; do
  if [ -n "$skip_next" ]; then skip_next=""; continue; fi
  case "$a" in
    --context|--config) skip_next=1; continue ;;   # global flags that take a value
    --*=*|-v|-vv|-vvv|--verbose|--agent|--no-color|--no-truncate) continue ;;
    -*) break ;;                                     # first command flag: the path has ended
    *) path+=("$a") ;;
  esac
done
# With gcx's own command list ($KGKIT_COMMANDS, one "gcx ..." path per line, written by
# run.py), take the longest prefix of the path that is a real command, so service names
# and query strings after it (a service called "api" or "test") are never mistaken for
# verbs. Without the list, check every word of the path: stricter, never looser.
words=("${path[@]}")
if [ -n "$KGKIT_COMMANDS" ] && [ -f "$KGKIT_COMMANDS" ]; then
  words=()
  cand="gcx"
  for w in "${path[@]}"; do
    cand="$cand $w"
    if grep -Fxq -- "$cand" "$KGKIT_COMMANDS"; then
      words+=("$w")
    else
      break
    fi
  done
fi
for i in "${!words[@]}"; do
  w="${words[$i]}"
  if [ "$i" -eq 0 ]; then
    case "$WRITE_GROUPS" in *" $w "*) blocked="gcx $w, which can change the stack or call any API" ;; esac
  fi
  case "$WRITE_VERBS" in *" $w "*) blocked="gcx ... $w, which changes the stack or starts something on it" ;; esac
  [ -n "$blocked" ] && break
done

# In the without-graph configuration the graph is hidden, not just refused: `gcx kg`
# answers as an unknown command, and help and discovery output leaves it out, so the
# agent doesn't spend turns on commands it can't use.
hidden=""
if [ -z "$blocked" ] && [ "$mode" = "without-graph" ]; then
  case "${path[0]}" in
    kg|knowledge-graph) hidden=1; blocked="the Knowledge Graph (gcx ${path[0]})" ;;
  esac
fi
if [ -z "$blocked" ] && [ "$mode" = "without-graph" ]; then
  for a in "$@"; do
    case "$a" in
      # the graph's own datasource and API groups, reachable through generic
      # commands such as gcx datasources query and gcx resources get (gcx 1.x)
      *knowledgegraph*|*kg.ext.grafana*|*kgatlas*|*kgschema*) blocked="the Knowledge Graph ($a)" ;;
    esac
    # recording rules the graph is built from. A matcher that excludes them
    # (__name__!~"asserts:.*") is fine; labels such as asserts_env are left alone.
    stripped=$(printf '%s' "$a" | sed -E 's/!~ *"[^"]*"//g')
    case "$stripped" in
      *asserts:*) blocked="Knowledge Graph recording rules (asserts: metrics)" ;;
    esac
    [ -n "$blocked" ] && break
  done
fi

# commands refused in every configuration, e.g. irm for an incident question, so the
# agent can't read the post-incident review instead of working the problem out
if [ -z "$blocked" ] && [ -n "$KGKIT_BLOCK_ALWAYS" ]; then
  for a in "$@"; do
    for b in ${KGKIT_BLOCK_ALWAYS//,/ }; do
      [ "$a" = "$b" ] && blocked="gcx $b for this question"
    done
  done
fi

status="ok"
[ -n "$blocked" ] && status="blocked"
# one line per command: UTC time, mode, ok|blocked, then the arguments, shell-quoted
printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$mode" "$status" "$(printf '%q ' "$@")" >> "$log"

hide="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/hide_kg.py"
ctx=()
[ -n "$KGKIT_CONTEXT" ] && ctx=(--context "$KGKIT_CONTEXT")

if [ -n "$hidden" ]; then
  # gcx's own unknown-command error, with the graph left out of its command list
  "$real" __kgkit_none__ 2>&1 | python3 -I "$hide" | sed "s/__kgkit_none__/${path[0]}/g"
  exit 2
fi

if [ -n "$blocked" ]; then
  echo "error: this test does not allow $blocked. It is read-only. Use metrics, traces, logs or other read commands instead." >&2
  exit 2
fi

if [ "$mode" != "without-graph" ]; then
  exec "$real" "${ctx[@]}" "$@"
fi

# without-graph: run it, and filter the graph out of help and discovery output (stdout)
# and out of any error text (stderr, which lists commands on a usage error)
helpish=""
case "${path[0]}" in
  ""|help|help-tree|commands|providers|agent) helpish=1 ;;
esac
for a in "$@"; do
  case "$a" in -h|--help) helpish=1 ;; esac
done
# gcx prints usage errors on stdout too, and they list every command, so stdout is
# also filtered when the command fails. Query results from a successful command
# pass through untouched.
outf=$(mktemp "${TMPDIR:-/tmp}/kgkit-out.XXXXXX")
errf=$(mktemp "${TMPDIR:-/tmp}/kgkit-err.XXXXXX")
"$real" "${ctx[@]}" "$@" >"$outf" 2>"$errf"
code=$?
if [ -n "$helpish" ] || [ "$code" -ne 0 ]; then
  python3 -I "$hide" < "$outf"
else
  cat "$outf"
fi
python3 -I "$hide" < "$errf" >&2
rm -f "$outf" "$errf"
exit "$code"
